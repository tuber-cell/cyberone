# ============================================================
# CyberOne — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ── Supabase ────────────────────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── JWT Secret ──────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# ── Upstash Redis (Rate Limiting) ───────────────────────────
# Get from: https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ── SecurityTrails API (Subdomains) ─────────────────────────
# Free plan: 50 queries/month — https://securitytrails.com
SECURITYTRAILS_API_KEY=your_securitytrails_api_key

# ── Shodan API (Open Ports) ─────────────────────────────────
# Free plan: limited queries — https://account.shodan.io
SHODAN_API_KEY=your_shodan_api_key

# ── HaveIBeenPwned API (Breach Data) ────────────────────────
# $3.50/month (cheapest paid) — https://haveibeenpwned.com/API/Key
# Leave empty to skip this check
HIBP_API_KEY=your_hibp_api_key

# ── WHOIS API ───────────────────────────────────────────────
# Free plan — https://whoisjsonapi.com or https://www.whoisxmlapi.com
WHOIS_API_KEY=your_whois_api_key

# ── Wappalyzer API (Technologies) ───────────────────────────
# Free plan — https://www.wappalyzer.com/api/
WAPPALYZER_API_KEY=your_wappalyzer_api_key

# ── SSL Labs ────────────────────────────────────────────────
# Completely free, no key needed
# SSL_LABS_API_URL=https://api.ssllabs.com/api/v3  (built-in)

# ── Google DNS ──────────────────────────────────────────────
# Completely free, no key needed
# GOOGLE_DNS_URL=https://dns.google/resolve  (built-in)

# ── App URL ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
